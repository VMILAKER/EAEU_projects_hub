# DB configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=eaeu_projects
DB_SERVER=localhost
DB_PORT=5434

# Backend API-key
INTERNAL_BACKEND_API_KEY=1995

# Sentence transformer name
SENTENCE_TRANSFORMER_MODEL_NAME=all-MiniLM-L6-v2

#LLM configuration
INSTRUCTION_PROMPT=Answer ONLY from sources below. If the answer is not in the sources, say you don't know.\n You have to summarise information from given sources and add desciption to each attached project. Insted of using numbers that point origins, use project names, e.g. insted of [1] may be certain project name. Present your answer like a connected text. \n\n
OLLAMA_PORT=11434
ANSWER_LANGUAGE=Русский
LLM_NAME=llama3.2:latest
LLM_TEMPERATURE=0.1

#RAG configuration
CROSS_ENCODER=cross-encoder/ms-marco-MiniLM-L-6-v2
ORIGINS_LIMIT=60